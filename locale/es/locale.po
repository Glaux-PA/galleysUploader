msgid "plugins.generic.publicationFormatsUploader.displayName"
msgstr "Cargador de formatos de publicación"

msgid "plugins.generic.publicationFormatsUploader.description"
msgstr "Carga por lotes archivos de prueba para formatos de publicación en OMP."

msgid "plugins.generic.publicationFormatsUploader.settings"
msgstr "Cargar formatos de publicación"

msgid "plugins.generic.publicationFormatsUploader.instructions"
msgstr "Seleccione un ZIP con pruebas llamadas <nombre>-[cap<idCapítulo>-][<configuraciónRegional>-]<idEnvío>.<extensión>."

msgid "plugins.generic.publicationFormatsUploader.upload"
msgstr "Cargar"

msgid "plugins.generic.publicationFormatsUploader.error.notZip"
msgstr "El archivo seleccionado no es un archivo ZIP."

msgid "plugins.generic.publicationFormatsUploader.error.cannotOpen"
msgstr "No se pudo abrir el archivo ZIP."

msgid "plugins.generic.publicationFormatsUploader.error.selectFile"
msgstr "Seleccione un archivo para cargar."

msgid "plugins.generic.publicationFormatsUploader.error.pluginDisabled"
msgstr "Active el complemento Cargador de formatos de publicación antes de usar esta acción."

msgid "plugins.generic.publicationFormatsUploader.error.ambiguousFormat"
msgstr "Más de un formato de publicación se llama '{$extension}'. No se modificó ningún formato."

msgid "plugins.generic.publicationFormatsUploader.error.invalidFormatIdentifier"
msgstr "'{$extension}' no es un identificador de formato de publicación válido."

msgid "plugins.generic.publicationFormatsUploader.error.physicalFormat"
msgstr "El formato de publicación '{$extension}' es físico y no puede recibir un archivo de prueba."

msgid "plugins.generic.publicationFormatsUploader.error.duplicateTarget"
msgstr "El archivo contiene más de un fichero para el mismo destino: {$files}. No se procesó ninguno."

msgid "plugins.generic.publicationFormatsUploader.error.invalidFileName"
msgstr "El nombre del archivo no contiene un ID de envío válido."

msgid "plugins.generic.publicationFormatsUploader.error.invalidSubmissionId"
msgstr "'{$submissionId}' no es un ID de envío válido."

msgid "plugins.generic.publicationFormatsUploader.error.invalidChapterId"
msgstr "'{$chapterId}' no es un ID de capítulo válido."

msgid "plugins.generic.publicationFormatsUploader.error.invalidLocale"
msgstr "'{$locale}' no es una configuración regional admitida en el nombre del archivo."

msgid "plugins.generic.publicationFormatsUploader.error.remoteFormat"
msgstr "El formato de publicación '{$extension}' utiliza una URL remota y no puede recibir un archivo de prueba."

msgid "plugins.generic.publicationFormatsUploader.error.submissionNotFound"
msgstr "No se encontró ningún envío con el ID {$submissionId} en esta editorial."

msgid "plugins.generic.publicationFormatsUploader.error.publicationNotFound"
msgstr "El envío {$submissionId} no tiene ninguna publicación."

msgid "plugins.generic.publicationFormatsUploader.error.chapterNotFound"
msgstr "No se encontró ningún capítulo con el ID {$chapterId}."

msgid "plugins.generic.publicationFormatsUploader.error.chapterNotInPublication"
msgstr "El capítulo {$chapterId} no pertenece a la publicación más reciente del envío {$submissionId}."

msgid "plugins.generic.publicationFormatsUploader.error.ambiguousProof"
msgstr "El formato de publicación '{$format}' tiene más de una prueba que coincide con el idioma {$locale}. No se modificó ninguna prueba."

msgid "plugins.generic.publicationFormatsUploader.error.manuscriptGenreMissing"
msgstr "El género de archivo MANUSCRIPT no está configurado para esta editorial."

msgid "plugins.generic.publicationFormatsUploader.error.dependentGenreMissing"
msgstr "El género de archivo {$genre} no está configurado para esta editorial."

msgid "plugins.generic.publicationFormatsUploader.error.dependentWithoutParent"
msgstr "El archivo dependiente {$file} no tiene una prueba HTML o XML del mismo envío, capítulo e idioma en esta carga."

msgid "plugins.generic.publicationFormatsUploader.error.dependentReplacement"
msgstr "No se pudo completar el reemplazo de archivos dependientes del envío {$submissionId}: {$message}"

msgid "plugins.generic.publicationFormatsUploader.error.file"
msgstr "No se pudo procesar {$file}: {$message}"

msgid "plugins.generic.publicationFormatsUploader.result.formatCreated"
msgstr "Se creó el formato de publicación {$format} para el envío {$submissionId}."

msgid "plugins.generic.publicationFormatsUploader.result.proofCreated"
msgstr "Se creó la prueba {$format} en {$locale} para el envío {$submissionId}."

msgid "plugins.generic.publicationFormatsUploader.result.proofRevised"
msgstr "Se añadió una nueva revisión a la prueba {$format} en {$locale} del envío {$submissionId}."

msgid "plugins.generic.publicationFormatsUploader.result.dependentCreated"
msgstr "Se creó el archivo dependiente {$file} para el envío {$submissionId}."

msgid "plugins.generic.publicationFormatsUploader.result.errors"
msgstr "Errores"

msgid "plugins.generic.publicationFormatsUploader.result.summary"
msgstr "Resumen de la carga"

msgid "plugins.generic.publicationFormatsUploader.result.noChanges"
msgstr "No se modificó ningún archivo."

msgid "plugins.generic.publicationFormatsUploader.error.proofTargetMismatch"
msgstr "OMP no guardó el idioma y la asignación de capítulo solicitados para la prueba."
